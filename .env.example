# Copy this file to .env to change settings. Every line is optional on your own computer.
# For a hosted (online) service, see DEPLOY.md: it lists the settings you must set.

# ---- Basics -------------------------------------------------------------------------------
# Port for the app.
PORT=3001

# Address the app listens on. 127.0.0.1 = this computer only (recommended on your own computer).
# A hosting service needs 0.0.0.0 (the Dockerfile already sets this).
HOST=127.0.0.1

# Leave empty to use the built-in database (PGlite, stored in DATA_DIR): fine on your own computer
# or for trying things out, NOT for a hosted service with paying clients.
# Required when NODE_ENV=production or when running on Render: the app refuses to start without it.
# For real use set a PostgreSQL address. For the optional local database in docker-compose.yml,
# first choose its password (used only on this computer; avoid $ in it, and URL-encode other symbols in the address):
# POSTGRES_PASSWORD=choose-a-password-for-the-local-database
# DATABASE_URL=postgres://costing:YOUR_POSTGRES_PASSWORD@localhost:5433/costing
# The password only takes effect when the local database is first created. To change it later run
#   docker compose exec db psql -U costing     then type:  \password costing   (keeps it out of shell history)
# and update DATABASE_URL. Do not run "docker compose down -v": that deletes the local data.
# (managed hosts give you a longer address of the same shape; if they ask for a secure connection,
# add ?sslmode=verify-full (or &sslmode=verify-full if the address already has a ?), or change
# sslmode=require in their address to sslmode=verify-full)

# Where the built-in database keeps its files (relative to the server folder).
DATA_DIR=.data

# Time zone of the businesses using the app. It decides what "today" is for trial ends, payment due
# dates, new trials, days left on the expiry board, and the dates in download and backup file names,
# whatever time zone the server's clock uses (hosts usually run on UTC).
APP_TIME_ZONE=Asia/Manila

# Which web address may call the API directly (only matters when developing with npm run dev).
# Do not set it on a host: a hosted app (production, or on Render) allows no other website by default.
# While developing it already defaults to the web dev server, so there is no need to set it:
# CORS_ORIGIN=http://localhost:5173

# ---- Hosted service (online, with logins) -----------------------------------------------------
# Your first sign-in: on first start, if no platform admin exists yet, one is created from these.
# Sign in, then DELETE these two lines (the password stays stored only as a hash).
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=a long password of at least 10 characters

# The public address of the service, used when building invite links.
# APP_ORIGIN=https://costing.example.com

# Production mode: logins are only sent over HTTPS (secure cookies), and the app refuses to start
# without a real PostgreSQL database in DATABASE_URL. Always set this when hosted; never on your own
# computer with the built-in database.
# NODE_ENV=production

# Set to true when a host's HTTPS proxy sits in front of the app (Render, Railway, Fly.io...), so the
# app sees each visitor's real address (used for the sign-in attempt limit).
# TRUST_PROXY=true

# Only for testing a production setup over plain http (for example http://localhost):
# COOKIE_SECURE=false
