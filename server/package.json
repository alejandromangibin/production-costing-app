{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:postgres": "node --env-file=../.env.test ../node_modules/vitest/vitest.mjs run",
    "test:db:setup": "tsx src/scripts/testDbSetup.ts",
    "typecheck": "tsc --noEmit",
    "backup": "tsx src/scripts/backup.ts",
    "restore": "tsx src/scripts/restore.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
